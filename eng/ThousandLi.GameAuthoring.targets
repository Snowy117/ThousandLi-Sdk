<Project>
  <PropertyGroup Condition="'$(IsThousandLiPackageArtifact)' == 'true'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ThousandLiPackageArtifactDirectory>$(OutputPath)PackageArtifact</ThousandLiPackageArtifactDirectory>
    <ThousandLiPackageArtifactZipPath>$(OutputPath)$(AssemblyName).zip</ThousandLiPackageArtifactZipPath>
  </PropertyGroup>

  <Target Name="BuildThousandLiFrontend" BeforeTargets="BuildThousandLiPackageArtifactDirectory"
          Condition="'$(IsThousandLiPackageArtifact)' == 'true' and '$(ThousandLiFrontendDirectory)' != ''">
    <Exec WorkingDirectory="$(ThousandLiFrontendDirectory)" Command="npm install" />
    <Exec WorkingDirectory="$(ThousandLiFrontendDirectory)" Command="npm run build" />
  </Target>

  <Target Name="BuildThousandLiPackageArtifactDirectory" AfterTargets="Build"
          Condition="'$(IsThousandLiPackageArtifact)' == 'true'">
    <ItemGroup>
      <ThousandLiPackageArtifactBinary Include="$(TargetPath)" />
      <ThousandLiPackageArtifactBinary Include="$(OutDir)*.deps.json" />
      <ThousandLiPackageArtifactBinary Include="@(ReferenceCopyLocalPaths)"
        Condition="'$(IsThousandLiExpertPackageArtifact)' != 'true' and '%(Filename)' != 'ThousandLi.Contracts'" />
      <!-- Expert packages share Contracts/ExpertContracts/ExpertAuthoring/logging with the DevHost:
           those DLLs are never distributed inside the artifact and always resolve to the
           DevHost-provided versions at load time. -->
      <ThousandLiPackageArtifactBinary Include="@(ReferenceCopyLocalPaths)"
        Condition="'$(IsThousandLiExpertPackageArtifact)' == 'true' and '%(Filename)' != 'ThousandLi.Contracts' and '%(Filename)' != 'ThousandLi.ExpertContracts' and '%(Filename)' != 'ThousandLi.ExpertAuthoring' and '%(Filename)' != 'Microsoft.Extensions.Logging.Abstractions'" />
      <ThousandLiPackageManifest Include="$(MSBuildProjectDirectory)/package.json" />
      <ThousandLiPackageFrontend Include="$(ThousandLiFrontendDirectory)/dist/**/*"
        Condition="'$(ThousandLiFrontendDirectory)' != ''" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/package.json')"
           Text="ThousandLi Package Artifact requires package.json beside the project file." />
    <RemoveDir Directories="$(ThousandLiPackageArtifactDirectory)" />
    <MakeDir Directories="$(ThousandLiPackageArtifactDirectory)/bin" />
    <Copy SourceFiles="@(ThousandLiPackageArtifactBinary)"
          DestinationFolder="$(ThousandLiPackageArtifactDirectory)/bin"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ThousandLiPackageManifest)"
          DestinationFolder="$(ThousandLiPackageArtifactDirectory)" />
    <Copy SourceFiles="@(ThousandLiPackageFrontend)"
          DestinationFiles="@(ThousandLiPackageFrontend->'$(ThousandLiPackageArtifactDirectory)/frontend/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Condition="'@(ThousandLiPackageFrontend)' != ''" />
  </Target>

  <Target Name="BuildThousandLiPackageArtifactZip" AfterTargets="BuildThousandLiPackageArtifactDirectory"
          Condition="'$(IsThousandLiPackageArtifact)' == 'true'">
    <Delete Files="$(ThousandLiPackageArtifactZipPath)" />
    <ZipDirectory SourceDirectory="$(ThousandLiPackageArtifactDirectory)"
                  DestinationFile="$(ThousandLiPackageArtifactZipPath)" />
  </Target>
</Project>
