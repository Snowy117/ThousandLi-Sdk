<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsThousandLiPackageArtifact>true</IsThousandLiPackageArtifact>
    <ThousandLiFrontendDirectory>$(MSBuildProjectDirectory)/frontend</ThousandLiFrontendDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="tests/**/*" />
    <PackageReference Include="ThousandLi.Contracts" Version="0.2.0-preview.1" />
    <PackageReference Include="ThousandLi.GameAuthoring" Version="0.2.0-preview.1" />
  </ItemGroup>
</Project>
