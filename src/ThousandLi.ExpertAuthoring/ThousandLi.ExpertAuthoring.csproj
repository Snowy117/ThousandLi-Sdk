<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ThousandLi.ExpertAuthoring</PackageId>
    <Description>Expert authoring base, the local BasicAi abstraction, and the OpenAI-compatible local gateway adapter for ThousandLi experts.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ThousandLi.Contracts/ThousandLi.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Expert-only authors do not consume ThousandLi.GameAuthoring, so the shared Package
         Artifact build targets must also ship from this package. The targets file stays
         single-sourced in eng/. -->
    <None Include="../../eng/ThousandLi.GameAuthoring.targets"
          Pack="true"
          PackagePath="buildTransitive/ThousandLi.ExpertAuthoring.targets" />
  </ItemGroup>
</Project>
